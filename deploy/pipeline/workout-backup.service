[Unit]
Description=Workout SQLite encrypted off-device backup and restore verification
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
User=root
UMask=0077
ExecStart=/usr/bin/python3 /opt/workout-controller/workoutctl.py --target /etc/workout-tracker/target.json backup
# Failure remains visible through systemctl status and the journal.
TimeoutStartSec=30min
